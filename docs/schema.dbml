// SkyRoute schema.dbml — paste at dbdiagram.io (free) → Export PNG/PDF.
// Option B for the ER diagram. Option A (recommended): MySQL Workbench →
// Database → Reverse Engineer from your live skyroute_db → EER + export.

Table Airports {
  airport_id int [pk, increment]
  iata_code char(3) [unique, not null]
  airport_name varchar(100) [unique, not null]
  city varchar(50) [not null]
  country varchar(50) [default: 'India']
}

Table Airlines {
  airline_id int [pk, increment]
  airline_name varchar(80) [unique, not null]
  iata_code char(2) [unique, not null]
  country varchar(50)
}

Table Aircraft {
  aircraft_id int [pk, increment]
  tail_number varchar(12) [unique, not null]
  model varchar(60) [not null]
  capacity int [not null]
  airline_id int [not null]
}

Table Flights {
  flight_id int [pk, increment]
  flight_number varchar(10) [unique, not null]
  airline_id int [not null]
  departure_airport_id int [not null]
  arrival_airport_id int [not null]
  sched_departure time [not null]
  sched_arrival time [not null]
  flight_status varchar(20) [default: 'Active']
}

Table Terminals {
  terminal_id int [pk, increment]
  airport_id int [not null]
  terminal_code varchar(4) [not null]
  terminal_name varchar(100) [not null]
}

Table Gates {
  gate_id int [pk, increment]
  terminal_id int [not null]
  gate_number varchar(6) [not null]
  gate_status varchar(20) [default: 'Open']
}

Table Runways {
  runway_id int [pk, increment]
  airport_id int [not null]
  runway_code varchar(10) [not null]
  length_metre decimal(7,2) [not null]
}

Table Flight_Instances {
  instance_id int [pk, increment]
  flight_id int [not null]
  scheduled_departure datetime [not null]
  scheduled_arrival datetime [not null]
  actual_departure datetime
  actual_arrival datetime
  instance_status varchar(20) [default: 'Scheduled']
  aircraft_id int
  gate_id int
  runway_id int
}

Table Passengers {
  passenger_id int [pk, increment]
  first_name varchar(60) [not null]
  last_name varchar(60) [not null]
  passport_number varchar(20) [unique]
  nationality varchar(50)
  phone varchar(20) [not null]
  email varchar(100) [unique, not null]
}

Table Bookings {
  booking_id int [pk, increment]
  passenger_id int [not null]
  instance_id int [not null]
  seat_number varchar(5) [not null]
  travel_class varchar(20) [default: 'Economy']
  price decimal(10,2) [not null]
  booking_status varchar(20) [default: 'Confirmed']
  booked_at datetime
  indexes { (instance_id, seat_number) [unique] }
}

Table Baggage {
  booking_id int [pk]
  baggage_seq int [pk]
  weight_kg decimal(5,2) [not null]
}

Table Payments {
  payment_id int [pk, increment]
  booking_id int [unique, not null]
  amount decimal(10,2) [not null]
  pay_method varchar(20) [not null]
  pay_status varchar(20) [default: 'Pending']
  txn_reference varchar(50) [unique]
  paid_at datetime
}

Table Check_Ins {
  checkin_id int [pk, increment]
  booking_id int [unique, not null]
  checkin_time datetime
  boarding_status varchar(20) [default: 'Not Boarded']
}

Table Employees {
  employee_id int [pk, increment]
  full_name varchar(100) [not null]
  email varchar(100) [unique, not null]
  phone varchar(20) [not null]
  base_airport int
  hire_date date [not null]
}

Table Pilots {
  employee_id int [pk]
  license_number varchar(30) [unique, not null]
  license_type varchar(10)
}

Table Crew_Members {
  employee_id int [pk]
  crew_role varchar(40) [not null]
}

Table Ground_Staff {
  employee_id int [pk]
  ground_role varchar(40) [not null]
  airport_id int
}

Table Crew_Assignments {
  assignment_id int [pk, increment]
  employee_id int [not null]
  instance_id int [not null]
  role_on_flight varchar(40) [not null]
}

Ref: Aircraft.airline_id > Airlines.airline_id
Ref: Flights.airline_id > Airlines.airline_id
Ref: Flights.departure_airport_id > Airports.airport_id
Ref: Flights.arrival_airport_id > Airports.airport_id
Ref: Terminals.airport_id > Airports.airport_id
Ref: Gates.terminal_id > Terminals.terminal_id
Ref: Runways.airport_id > Airports.airport_id
Ref: Flight_Instances.flight_id > Flights.flight_id
Ref: Flight_Instances.aircraft_id > Aircraft.aircraft_id
Ref: Flight_Instances.gate_id > Gates.gate_id
Ref: Flight_Instances.runway_id > Runways.runway_id
Ref: Bookings.passenger_id > Passengers.passenger_id
Ref: Bookings.instance_id > Flight_Instances.instance_id
Ref: Baggage.booking_id > Bookings.booking_id
Ref: Payments.booking_id > Bookings.booking_id
Ref: Check_Ins.booking_id > Bookings.booking_id
Ref: Employees.base_airport > Airports.airport_id
Ref: Pilots.employee_id > Employees.employee_id
Ref: Crew_Members.employee_id > Employees.employee_id
Ref: Ground_Staff.employee_id > Employees.employee_id
Ref: Ground_Staff.airport_id > Airports.airport_id
Ref: Crew_Assignments.employee_id > Employees.employee_id
Ref: Crew_Assignments.instance_id > Flight_Instances.instance_id
